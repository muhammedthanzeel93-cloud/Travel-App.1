NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/travel_buddy
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters-in-production
CORS_ORIGIN=http://localhost:4550

# Required for registration, password reset, and admin 2FA. The endpoint must
# accept POST JSON { to, channel, purpose, code, expiresInSeconds } and send it
# through the configured email/SMS provider. Keep the bearer token private.
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_TOKEN=

# Set only when running the one-time bootstrap command, then clear these values.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
